---
const { currentPath = '/' } = Astro.props;

const navigationSections = [
  {
    title: 'Primary',
    items: [
      { number: '1.0', label: 'Entry', href: '/' },
      { number: '2.0', label: 'Index', href: '/index' },
      { 
        number: '3.0', 
        label: 'Manifesto', 
        href: '/manifesto',
        nested: [
          { number: '3.1', label: 'Foundations', href: '/manifesto/foundations' },
        ]
      },
      { number: '4.0', label: 'Works', href: '/works' },
      { number: '5.0', label: 'Texts', href: '/texts' },
      { number: '6.0', label: 'Plates', href: '/plates' },
      { number: '7.0', label: 'Editions', href: '/editions' },
      { number: '8.0', label: 'Archive', href: '/archive' },
    ]
  },
  {
    title: 'System',
    items: [
      { number: '9.0', label: 'Doctrine', href: '/doctrine' },
      { number: '10.0', label: 'Methodology', href: '/methodology' },
      { number: '11.0', label: 'Instruments', href: '/instruments' },
      { number: '12.0', label: 'Contact', href: '/contact' },
    ]
  }
];
---

<nav>
  <div class="nav-header">
    <div class="site-title-nav">
      <a href="/">House of Laline</a>
    </div>
    <div class="site-subtitle-nav">Structured knowledge system</div>
  </div>

  {navigationSections.map(section => (
    <div class="nav-section">
      <div class="nav-section-header">
        <div class="nav-section-title">{section.title}</div>
        <div class="nav-section-toggle">▼</div>
      </div>
      <ul class="nav-list">
        {section.items.map(item => (
          <li>
            <a 
              href={item.href} 
              class={currentPath === item.href ? 'active' : ''}
            >
              <span class="nav-number">{item.number}</span>
              <span>{item.label}</span>
            </a>
            {item.nested && (
              <ul class="nav-nested">
                {item.nested.map(nested => (
                  <li>
                    <a 
                      href={nested.href}
                      class={currentPath === nested.href ? 'active' : ''}
                    >
                      <span class="nav-number">{nested.number}</span>
                      <span>{nested.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </div>
  ))}

  <div class="nav-footer">
    Last updated: Feb 5, 2026<br>
    Version 1.2.4<br>
    <a href="mailto:contact@laline.house">Email</a>
  </div>
</nav>

<style>
  nav {
    width: var(--nav-width);
    background-color: var(--bg-nav);
    border-right: 1px solid var(--border);
    padding: 3rem 0;
    position: fixed;
    height: 100vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    z-index: 10;
  }

  .nav-header {
    padding: 0 2rem;
    margin-bottom: 3rem;
  }

  .site-title-nav {
    font-size: 1.3rem;
    font-weight: 400;
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .site-title-nav a {
    color: var(--text);
    text-decoration: none;
  }

  .site-subtitle-nav {
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.03em;
  }

  .nav-section {
    margin-bottom: 2rem;
  }

  .nav-section-header {
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    user-select: none;
    margin-bottom: 1rem;
  }

  .nav-section-title {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .nav-section-toggle {
    font-size: 0.7rem;
    color: var(--text-tertiary);
    transition: transform 0.2s;
  }

  .nav-section.collapsed .nav-section-toggle {
    transform: rotate(-90deg);
  }

  .nav-section.collapsed .nav-list {
    display: none;
  }

  .nav-list {
    list-style: none;
  }

  .nav-list li {
    position: relative;
  }

  .nav-list > li > a {
    padding: 0.7rem 2rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text);
    text-decoration: none;
    font-size: 0.975rem;
    transition: all 0.2s;
    position: relative;
  }

  .nav-list > li > a:hover {
    background-color: rgba(0, 0, 0, 0.02);
  }

  .nav-list > li > a:hover span:last-child {
    text-decoration: underline;
  }

  .nav-list > li > a.active {
    background-color: rgba(0, 0, 0, 0.03);
  }

  .nav-list > li > a.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background-color: var(--accent);
  }

  .nav-number {
    font-size: 0.8rem;
    color: var(--text-tertiary);
    font-family: 'Courier New', monospace;
    min-width: 2.5rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .nav-nested {
    list-style: none;
    position: relative;
  }

  .nav-nested::before {
    content: '';
    position: absolute;
    left: 2.75rem;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: var(--border);
  }

  .nav-nested li {
    position: relative;
  }

  .nav-nested > li > a {
    padding: 0.6rem 2rem 0.6rem 3.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    transition: all 0.2s;
    position: relative;
    letter-spacing: 0.01em;
  }

  .nav-nested > li > a::before {
    content: '';
    position: absolute;
    left: 2.75rem;
    top: 50%;
    width: 0.5rem;
    height: 1px;
    background-color: var(--border);
  }

  .nav-nested > li > a:hover {
    color: var(--text);
    background-color: rgba(0, 0, 0, 0.02);
  }

  .nav-nested > li > a:hover span:last-child {
    text-decoration: underline;
  }

  .nav-nested > li > a.active {
    color: var(--text);
    font-weight: 400;
  }

  .nav-footer {
    margin-top: auto;
    padding: 2rem 2rem 0;
    border-top: 1px solid var(--border);
    font-size: 0.775rem;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .nav-footer a {
    color: var(--text);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    nav {
      position: static;
      width: 100%;
      height: auto;
      border-right: none;
      border-bottom: 1px solid var(--border);
      padding: 2rem 0;
    }

    .nav-nested {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll('.nav-section-header').forEach(header => {
    header.addEventListener('click', () => {
      header.parentElement?.classList.toggle('collapsed');
    });
  });
</script>
