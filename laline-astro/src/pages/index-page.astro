---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Index" currentPath="/index">
  <div class="breadcrumb">
    <a href="/">Home</a> / Index
  </div>

  <h1>Index</h1>
  <p class="page-meta">Complete directory of all system resources · Updated February 2026</p>

  <div class="content-section">
    <p>
      A reference system for accessing hierarchical knowledge. Content is organized by vertical clarity, not promotional weight. Everything here is findable, stable, and deliberate.
    </p>
  </div>

  <ul class="section-list">
    <li>
      <a href="/works">Works</a>
      <p class="section-desc">Editorial structures and design systems for implementation.</p>
    </li>
    <li>
      <a href="/texts">Texts</a>
      <p class="section-desc">Long-form essays on design thinking, methodology, and practice.</p>
    </li>
    <li>
      <a href="/plates">Plates</a>
      <p class="section-desc">Distilled design principles. Citable, quotable maxims.</p>
    </li>
    <li>
      <a href="/editions">Editions</a>
      <p class="section-desc">Curated collections of works and plates released together.</p>
    </li>
    <li>
      <a href="/archive">Archive</a>
      <p class="section-desc">Historical record of sold editions and discontinued works.</p>
    </li>
    <li>
      <a href="/doctrine">Doctrine</a>
      <p class="section-desc">System principles, structural constraints, and mandatory rules.</p>
    </li>
    <li>
      <a href="/methodology">Methodology</a>
      <p class="section-desc">Documentation of organizational processes and decision frameworks.</p>
    </li>
    <li>
      <a href="/instruments">Instruments</a>
      <p class="section-desc">Tools for validating design execution against principles.</p>
    </li>
  </ul>
</BaseLayout>

<style>
  .breadcrumb {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 3rem;
  }

  .breadcrumb a {
    color: var(--text-secondary);
    text-decoration: underline;
  }

  .breadcrumb a:hover {
    color: var(--text);
  }

  .page-meta {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 3rem;
    font-style: italic;
  }

  .content-section {
    margin-bottom: 3rem;
  }

  .section-list {
    list-style: none;
    margin-top: 2rem;
  }

  .section-list li {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .section-list li:last-child {
    border-bottom: none;
  }

  .section-list a {
    color: var(--text);
    text-decoration: none;
    font-size: 1.2rem;
    display: inline;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }

  .section-list a:hover {
    border-bottom-color: var(--text);
  }

  .section-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
    line-height: 1.6;
  }
</style>
