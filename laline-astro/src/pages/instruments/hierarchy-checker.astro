---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Hierarchy Checker" currentPath="/instruments/hierarchy-checker">
  <div class="breadcrumb">
    <a href="/">Entry</a> / <a href="/instruments">Instruments</a> / Hierarchy Checker
  </div>

  <article class="instrument-page">
    <header class="instrument-header-main">
      <div class="instrument-meta">
        <span class="instrument-number">I02</span>
        <span class="instrument-status">Available</span>
      </div>
      <h1>Hierarchy Checker</h1>
      <p class="abstract">Does the eye know where to start? Hierarchy is not taste—it is perceptual physics.</p>
    </header>

    <section class="instrument-explanation">
      <h2>Purpose</h2>
      <p>
        A composition should have a single entry point. The eye should land immediately, without search. When multiple elements compete for attention with equal visual weight, hierarchy collapses. The reader arrives but cannot begin.
      </p>

      <h2>Methodology</h2>
      <p>
        This checker counts visual focal points within a composition. Focal points are elements that command attention through scale, contrast, position, or isolation. One focal point indicates clear hierarchy. Multiple focal points indicate competing emphasis.
      </p>
      <p>
        The checker evaluates:
      </p>
      <ul>
        <li><strong>Scale dominance</strong> — Is one element significantly larger?</li>
        <li><strong>Contrast prominence</strong> — Does one element differ most from surroundings?</li>
        <li><strong>Spatial priority</strong> — Is one element positioned at natural entry points?</li>
        <li><strong>Isolation strength</strong> — Is one element surrounded by more space?</li>
      </ul>
      <p>
        PASS requires a single dominant element. CAUTION indicates emerging competition. BREACH occurs when attention scatters across multiple equal emphases.
      </p>
    </section>

    <div class="tool-container">
      <h2>Checker</h2>
      
      <div class="tool-step">
        <h3>Evaluate Your Composition</h3>
        <p class="tool-instruction">Answer each question by observing your design. Be honest about what draws attention.</p>
      </div>

      <div class="question-group">
        <div class="question">
          <p class="question-text"><strong>1.</strong> How many elements are significantly larger than others?</p>
          <div class="radio-group">
            <label><input type="radio" name="q1" value="1"> One element dominates scale</label>
            <label><input type="radio" name="q1" value="2"> Two elements share largest scale</label>
            <label><input type="radio" name="q1" value="3"> Three or more large elements</label>
          </div>
        </div>

        <div class="question">
          <p class="question-text"><strong>2.</strong> How many elements have high contrast (dark vs light)?</p>
          <div class="radio-group">
            <label><input type="radio" name="q2" value="1"> One element has strongest contrast</label>
            <label><input type="radio" name="q2" value="2"> Two elements share high contrast</label>
            <label><input type="radio" name="q2" value="3"> Multiple elements contrast strongly</label>
          </div>
        </div>

        <div class="question">
          <p class="question-text"><strong>3.</strong> Which position(s) have prominent elements?</p>
          <div class="radio-group">
            <label><input type="radio" name="q3" value="1"> Top-left only (natural entry)</label>
            <label><input type="radio" name="q3" value="2"> Top-left and one other corner</label>
            <label><input type="radio" name="q3" value="3"> Multiple corners/positions</label>
          </div>
        </div>

        <div class="question">
          <p class="question-text"><strong>4.</strong> How many elements are surrounded by significant empty space?</p>
          <div class="radio-group">
            <label><input type="radio" name="q4" value="1"> One element clearly isolated</label>
            <label><input type="radio" name="q4" value="2"> Two elements equally isolated</label>
            <label><input type="radio" name="q4" value="3"> Multiple elements isolated</label>
          </div>
        </div>

        <div class="question">
          <p class="question-text"><strong>5.</strong> When you first look at the composition, where does your eye land?</p>
          <div class="radio-group">
            <label><input type="radio" name="q5" value="1"> One specific element immediately</label>
            <label><input type="radio" name="q5" value="2"> Jumps between two elements</label>
            <label><input type="radio" name="q5" value="3"> Searches or scans without landing</label>
          </div>
        </div>
      </div>

      <button id="check-btn" class="check-button">Check Hierarchy</button>

      <div id="result" class="result-container" style="display: none;">
        <div class="result-header">
          <span class="verdict-badge"></span>
          <h3 class="verdict-title"></h3>
        </div>
        <div class="result-content">
          <div class="count-display">
            <span class="count-label">Detected Focal Points:</span>
            <span class="count-value"></span>
          </div>
          <p class="result-explanation"></p>
          <div class="result-guidance"></div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .breadcrumb {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 3rem;
  }

  .breadcrumb a {
    color: var(--text-secondary);
    text-decoration: underline;
  }

  .breadcrumb a:hover {
    color: var(--text);
  }

  .instrument-page {
    max-width: 800px;
  }

  .instrument-header-main {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .instrument-meta {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    font-family: 'Courier New', monospace;
    font-size: 0.8rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
  }

  .instrument-header-main h1 {
    font-size: 2.25rem;
    font-weight: 400;
    margin-bottom: 1rem;
  }

  .abstract {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-secondary);
    font-style: italic;
  }

  .instrument-explanation {
    margin-bottom: 3rem;
  }

  .instrument-explanation h2 {
    font-size: 1.3rem;
    font-weight: 400;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .instrument-explanation p,
  .instrument-explanation ul {
    margin-bottom: 1.5rem;
    line-height: 1.8;
  }

  .instrument-explanation ul {
    padding-left: 1.5rem;
  }

  .instrument-explanation li {
    margin-bottom: 0.75rem;
  }

  .tool-container {
    background-color: var(--bg-nav);
    border: 1px solid var(--border);
    padding: 2rem;
    margin: 3rem 0;
  }

  .tool-container h2 {
    font-size: 1.3rem;
    font-weight: 400;
    margin-bottom: 1.5rem;
  }

  .tool-step {
    margin-bottom: 2rem;
  }

  .tool-step h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.85rem;
  }

  .tool-instruction {
    font-size: 0.95rem;
    color: var(--text-secondary);
    font-style: italic;
  }

  .question-group {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .question {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .question:last-child {
    border-bottom: none;
  }

  .question-text {
    font-size: 0.95rem;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .radio-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-left: 1rem;
  }

  .radio-group label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    font-size: 0.9rem;
    padding: 0.5rem 0;
  }

  .radio-group input[type="radio"] {
    cursor: pointer;
  }

  .check-button {
    width: 100%;
    padding: 1rem;
    background: var(--text);
    color: var(--bg);
    border: none;
    font-family: 'Crimson Text', serif;
    font-size: 1rem;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .check-button:hover {
    opacity: 0.85;
  }

  .check-button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .result-container {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .result-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .verdict-badge {
    font-family: 'Courier New', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    padding: 0.35rem 0.75rem;
    border: 1px solid;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .verdict-badge.pass {
    color: #2d5016;
    border-color: #2d5016;
  }

  .verdict-badge.caution {
    color: #8b6914;
    border-color: #8b6914;
  }

  .verdict-badge.breach {
    color: #7d1e1e;
    border-color: #7d1e1e;
  }

  .verdict-title {
    font-size: 1.2rem;
    font-weight: 400;
    margin: 0;
  }

  .count-display {
    font-family: 'Courier New', monospace;
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .count-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .count-value {
    font-weight: 600;
  }

  .result-explanation {
    margin-bottom: 1.5rem;
    line-height: 1.8;
  }

  .result-guidance {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.7;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
</style>

<script>
  function checkHierarchy() {
    const answers = [];
    for (let i = 1; i <= 5; i++) {
      const selected = document.querySelector(`input[name="q${i}"]:checked`);
      if (!selected) {
        alert('Please answer all questions');
        return;
      }
      answers.push(parseInt(selected.value));
    }

    // Calculate focal point score (1-3 scale per question)
    const totalScore = answers.reduce((a, b) => a + b, 0);
    const avgScore = totalScore / 5;

    const result = document.getElementById('result');
    const badge = result.querySelector('.verdict-badge');
    const title = result.querySelector('.verdict-title');
    const countValue = result.querySelector('.count-value');
    const explanation = result.querySelector('.result-explanation');
    const guidance = result.querySelector('.result-guidance');

    let verdict, verdictText, focalPoints, explanationText, guidanceText;

    // Score interpretation:
    // 1.0-1.4 = Single focal point (PASS)
    // 1.5-2.0 = Emerging competition (CAUTION)
    // 2.1-3.0 = Multiple focal points (BREACH)

    if (avgScore <= 1.4) {
      verdict = 'pass';
      verdictText = 'PASS — Clear Hierarchy';
      focalPoints = '1 (Single Entry Point)';
      explanationText = 'Hierarchy is intact. A single element commands attention through multiple visual attributes. The eye knows where to begin. This is structural clarity.';
      guidanceText = 'Maintain this clarity. When adding elements, ensure they remain subordinate to the primary focal point through scale, contrast, or position.';
    } else if (avgScore <= 2.0) {
      verdict = 'caution';
      verdictText = 'CAUTION — Competing Emphasis';
      focalPoints = '2-3 (Scattered Attention)';
      explanationText = 'Multiple elements are competing for primary attention. The eye hesitates between them. Hierarchy exists but is weakening. This is structural ambiguity.';
      guidanceText = 'Strengthen one focal point by increasing its scale, contrast, or isolation. Reduce visual weight of competing elements. Hierarchy requires one clear winner.';
    } else {
      verdict = 'breach';
      verdictText = 'BREACH — Hierarchy Collapsed';
      focalPoints = '3+ (No Entry Point)';
      explanationText = 'Hierarchy has failed. Multiple elements command equal attention. The eye searches without landing. This is not a matter of preference—it is perceptual chaos.';
      guidanceText = 'Fundamental restructuring required. Select one element to dominate. Reduce all others through: smaller scale, lower contrast, or greater distance from entry points. Nothing competes with primary emphasis.';
    }

    badge.className = `verdict-badge ${verdict}`;
    badge.textContent = verdict.toUpperCase();
    title.textContent = verdictText;
    countValue.textContent = focalPoints;
    explanation.textContent = explanationText;
    guidance.textContent = guidanceText;

    result.style.display = 'block';
    result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  document.getElementById('check-btn').addEventListener('click', checkHierarchy);
</script>
