---
const { currentPath = '/' } = Astro.props;
const isActive = (path: string) => currentPath === path;
const isParentActive = (paths: string[]) => paths.some(p => currentPath.startsWith(p));
const atlasEssayPath = '/texts/how-your-work-meets-the-screen';
const atlasUrl = import.meta.env.PUBLIC_ATLAS_URL ?? 'http://127.0.0.1:4322';
const isHouseActive = isActive('/') || isActive('/preface');
const isDoctrineActive = isActive('/doctrine') || isParentActive(['/manifesto']);
const isAtlasActive = isParentActive(['/works']) || isActive(atlasEssayPath);
---

<nav>
  <div class="nav-inner">

    <a href="/" class="nav-brand">House of Laline</a>

    <div class="nav-sections">

      <div class="nav-group">
        <div class="nav-row">
          <span class="nav-num">I.</span>
          <a href="/" class={`nav-title ${isHouseActive ? 'active' : ''}`}>House</a>
        </div>
        <ul class="nav-sub">
          <li class={isActive('/preface') ? 'dot-active' : ''}><a href="/preface">Preface</a></li>
        </ul>
      </div>

      <div class="nav-group">
        <div class="nav-row">
          <span class="nav-num">II.</span>
          <a href="/doctrine" class={`nav-title ${isDoctrineActive ? 'active' : ''}`}>Doctrine</a>
        </div>
        <ul class="nav-sub">
          <li class={isParentActive(['/manifesto']) ? 'dot-active' : ''}><a href="/manifesto">Manifesto</a></li>
        </ul>
      </div>

      <div class="nav-group group-break">
        <div class="nav-row">
          <span class="nav-num">III.</span>
          <a href="/works" class={`nav-title ${isAtlasActive ? 'active' : ''}`}>Works</a>
        </div>
        <ul class="nav-sub">
          <li class={isParentActive(['/works']) ? 'dot-active' : ''}><a href="/works#atlas">Atlas</a></li>
          <li class={isActive(atlasEssayPath) ? 'dot-active' : ''}><a href={atlasEssayPath}>Reading</a></li>
          <li><a href={atlasUrl}>Live demo <span aria-hidden="true">↗</span></a></li>
        </ul>
      </div>

      <div class="nav-group">
        <div class="nav-row">
          <span class="nav-num">IV.</span>
          <a href="/texts" class={`nav-title ${isParentActive(['/texts']) && !isActive(atlasEssayPath) ? 'active' : ''}`}>Texts</a>
        </div>
      </div>

      <div class="nav-group">
        <div class="nav-row">
          <span class="nav-num">V.</span>
          <a href="/plates" class={`nav-title ${isParentActive(['/plates']) ? 'active' : ''}`}>Plates</a>
        </div>
      </div>

    </div>

    <footer class="nav-footer">
      <p>LALINE &nbsp; V1.6</p>
      <p class="footer-gap">Built slowly. Issued when ready.</p>
    </footer>
  </div>
</nav>

<style>
  nav {
    width: var(--nav-width);
    height: 100vh;
    position: fixed;
    top: 0; left: 0;
    background: var(--color-bg);
    overflow: hidden;
    z-index: 10;
  }

  .nav-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 3.5rem 1.5rem 2.25rem;
    overflow: hidden;
  }

  /* ── Brand ── */
  .nav-brand {
    font-family: var(--font-ui);
    font-size: var(--text-nav);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    margin-bottom: 2.5rem;
    flex-shrink: 0;
  }
  .nav-brand:hover { opacity: 0.5; }

  /* ── Sections ── */
  .nav-sections {
    flex: 1;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .nav-group {
    margin-bottom: 1.3rem;
    flex-shrink: 0;
  }

  .nav-group.group-break { margin-bottom: 3.4rem; }

  /* ── Row ── */
  .nav-row {
    display: block;
  }

  /* ── Numeral — right aligned so dots line up ── */
  .nav-num {
    font-family: var(--font-ui);
    font-size: var(--text-nav);
    font-weight: var(--weight-medium);
    color: var(--color-ink);
    display: block;
    margin-bottom: 0.1rem;
  }

  /* ── Title ── */
  .nav-title {
    font-family: var(--font-ui);
    font-size: var(--text-nav);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    display: block;
    padding-left: 1.5rem;
  }
  .nav-title:hover { opacity: 0.5; }
  .nav-title.active { color: var(--color-secondary); }

  /* ── Sub items ── */
  .nav-sub {
    list-style: none;
    margin-top: 0.1rem;
    padding-left: 1.5rem;
  }

  .nav-sub li {
    display: grid;
    grid-template-columns: 0.5rem 1fr;
    align-items: center;
    line-height: 1.7;
  }

  .nav-sub li::before {
    content: '';
    width: 3px; height: 3px;
    border-radius: 50%;
    background: var(--color-secondary);
    opacity: 0;
    justify-self: end;
    margin-right: 0.25rem;
  }

  .nav-sub li.dot-active::before { opacity: 1; }

  .nav-sub a {
    font-family: var(--font-ui);
    font-size: var(--text-nav);
    font-weight: var(--weight-regular);
    color: var(--color-ink);
    opacity: 0.45;
    text-decoration: none;
  }
  .nav-sub a:hover { opacity: 0.7; }

  /* ── Footer ── */
  .nav-footer {
    margin-top: auto;
    padding-top: 2rem;
    flex-shrink: 0;
    font-family: var(--font-ui);
    font-size: 0.5rem;
    font-weight: var(--weight-regular);
    color: var(--color-secondary);
    line-height: 1.5;
  }

  .nav-footer p {
    max-width: none;
    margin: 0;
    font: inherit;
    white-space: nowrap;
  }

  .nav-footer .footer-gap { margin-top: 0.5rem; }

  @media (max-width: 768px) { nav { display: none; } }
</style>
