---
const { currentPath = '/' } = Astro.props;
const isActive = (path: string) => currentPath === path;
const isParentActive = (paths: string[]) => paths.some(p => currentPath.startsWith(p));
---

<nav>
  <div class="nav-inner">

    <a href="/" class="nav-brand">House of Laline</a>

    <div class="nav-sections">

      <div class="nav-group">
        <div class="nav-row">
          <span class="nav-num">I.</span>
          <a href="/index-page" class={`nav-title ${isActive('/index-page') ? 'active' : ''}`}>Index</a>
        </div>
      </div>

      <div class="nav-group">
        <div class="nav-row">
          <span class="nav-num">II.</span>
          <a href="/preface" class={`nav-title ${isActive('/preface') ? 'active' : ''}`}>Preface</a>
        </div>
      </div>

      <div class="nav-group gap">
        <div class="nav-row">
          <span class="nav-num">III.</span>
          <a href="/doctrine" class={`nav-title ${isActive('/doctrine') ? 'active' : ''}`}>Doctrine</a>
        </div>
      </div>

      <div class="nav-group">
        <div class="nav-row">
          <span class="nav-num">IV.</span>
          <a href="/manifesto" class={`nav-title ${isParentActive(['/manifesto']) ? 'active' : ''}`}>Manifesto</a>
        </div>
        <ul class="nav-sub">
          <li class={isParentActive(['/manifesto/foundations']) ? 'dot-active' : ''}><a href="/manifesto/foundations">Foundations</a></li>
          <li class={isParentActive(['/manifesto/composition']) ? 'dot-active' : ''}><a href="/manifesto/composition">Composition</a></li>
          <li class={isParentActive(['/manifesto/expression']) ? 'dot-active' : ''}><a href="/manifesto/expression">Expression</a></li>
        </ul>
      </div>

      <div class="nav-group gap">
        <div class="nav-row">
          <span class="nav-num">V.</span>
          <a href="/canon" class={`nav-title ${isActive('/canon') ? 'active' : ''}`}>Canon</a>
        </div>
        <ul class="nav-sub">
          <li class={isActive('/texts') ? 'dot-active' : ''}><a href="/texts">Texts</a></li>
          <li class={isActive('/plates') ? 'dot-active' : ''}><a href="/plates">Plates</a></li>
        </ul>
      </div>

      <div class="nav-group">
        <div class="nav-row">
          <span class="nav-num">VI.</span>
          <a href="/decision-framework" class={`nav-title ${isActive('/decision-framework') ? 'active' : ''}`}>Frameworks</a>
        </div>
      </div>

      <div class="nav-group gap">
        <div class="nav-row">
          <span class="nav-num">VII.</span>
          <a href="/measured-design" class={`nav-title ${isParentActive(['/measured-design']) ? 'active' : ''}`}>Measures</a>
        </div>
        <ul class="nav-sub">
          <li class={isActive('/measured-design/modular-scale') ? 'dot-active' : ''}><a href="/measured-design/modular-scale">Modular</a></li>
          <li class={isActive('/measured-design/grid-anatomy') ? 'dot-active' : ''}><a href="/measured-design/grid-anatomy">Grid</a></li>
          <li class={isActive('/measured-design/rhythm-spacing') ? 'dot-active' : ''}><a href="/measured-design/rhythm-spacing">Rhythm</a></li>
        </ul>
      </div>

      <div class="nav-group">
        <div class="nav-row">
          <span class="nav-num">VIII.</span>
          <a href="/style-ecosystem" class={`nav-title ${isParentActive(['/style-ecosystem', '/resources', '/glossary']) ? 'active' : ''}`}>System</a>
        </div>
        <ul class="nav-sub">
          <li class={isActive('/style-ecosystem') ? 'dot-active' : ''}><a href="/style-ecosystem">Style Ecosystem</a></li>
          <li class={isActive('/resources') ? 'dot-active' : ''}><a href="/resources">Resources</a></li>
          <li class={isActive('/glossary') ? 'dot-active' : ''}><a href="/glossary">Glossary</a></li>
        </ul>
      </div>

    </div>
  </div>
</nav>

<style>
  nav {
    width: var(--nav-width);
    height: 100vh;
    position: fixed;
    top: 0; left: 0;
    background: var(--color-bg);
    overflow: hidden;
    z-index: 10;
  }

  .nav-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 3.5rem 1.5rem 1.75rem;
    overflow: hidden;
  }

  /* ── Brand ── */
  .nav-brand {
    font-family: var(--font-ui);
    font-size: var(--text-nav);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    margin-bottom: 2.5rem;
    flex-shrink: 0;
  }
  .nav-brand:hover { opacity: 0.5; }

  /* ── Sections ── */
  .nav-sections {
    flex: 1;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .nav-group { margin-bottom: 1.35rem; flex-shrink: 0; }
  .nav-group.gap { margin-bottom: 2.75rem; }

  /* ── Row ── */
  .nav-row {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: baseline;
  }

  /* ── Numeral — right aligned so dots line up ── */
  .nav-num {
    font-family: var(--font-ui);
    font-size: var(--text-nav);
    font-weight: var(--weight-medium);
    color: var(--color-ink);
    text-align: right;
    padding-right: 0.4rem;
  }

  /* ── Title ── */
  .nav-title {
    font-family: var(--font-ui);
    font-size: var(--text-nav);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
  }
  .nav-title:hover { opacity: 0.5; }
  .nav-title.active { color: var(--color-secondary); }

  /* ── Sub items ── */
  .nav-sub {
    list-style: none;
    margin-top: 0.2rem;
  }

  .nav-sub li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: center;
    line-height: 1.85;
  }

  .nav-sub li::before {
    content: '';
    width: 3px; height: 3px;
    border-radius: 50%;
    background: var(--color-secondary);
    opacity: 0;
    justify-self: end;
    margin-right: 0.4rem;
  }

  .nav-sub li.dot-active::before { opacity: 1; }

  .nav-sub a {
    font-family: var(--font-ui);
    font-size: var(--text-nav);
    font-weight: var(--weight-regular);
    color: var(--color-ink);
    opacity: 0.45;
    text-decoration: none;
  }
  .nav-sub a:hover { opacity: 0.7; }

  @media (max-width: 768px) { nav { display: none; } }
</style>