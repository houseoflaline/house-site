---
import Navigation from '../components/Navigation.astro';
import '../styles/global.css';

interface Props {
  title: string;
  currentPath?: string;
  landing?: boolean;
}

const { title, currentPath = '/', landing = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{landing ? title : `${title} · House of Laline`}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body>
  <div class="layout">
    <Navigation currentPath={currentPath} />
    <main class={landing ? 'main--landing' : 'main--content'}>
      <slot />
    </main>
  </div>
</body>
</html>

<style>
  .layout {
    display: flex;
    min-height: 100vh;
  }

  /* ── Standard content pages ── */
  .main--content {
    margin-left: var(--nav-width);
    flex: 1;
    padding: 4rem 5rem;
    max-width: 860px;
  }

  /* ── Landing page — centred, full height ── */
  .main--landing {
    margin-left: var(--nav-width);
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .main--content  { padding: 3rem 3.5rem; }
    .main--landing  { padding: 2rem; }
  }

  @media (max-width: 768px) {
    .layout { flex-direction: column; }
    .main--content,
    .main--landing {
      margin-left: 0;
      padding: 2rem 1.5rem;
    }
  }
</style>