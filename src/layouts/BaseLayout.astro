---
import Navigation from '../components/Navigation.astro';
import '../styles/global.css';

interface Props {
  title: string;
  currentPath?: string;
  landing?: boolean;
}

const { title, currentPath = '/', landing = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{landing ? title : `${title} · House of Laline`}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body>
  <div class={`layout ${landing ? 'layout--landing' : ''}`}>
    <Navigation currentPath={currentPath} />
    <main class={landing ? 'main--landing' : 'main--content'}>
      <slot />
    </main>
  </div>
</body>
</html>

<style>
  /* ── Kill all horizontal overflow at root ── */
  html {
    overflow-x: hidden;
  }

  body {
    overflow-x: hidden;
    min-height: 100vh;
  }

  /* ── Landing: locked to viewport, no scroll ── */
  body:has(.layout--landing) {
    overflow: hidden;
    height: 100vh;
  }

  .layout {
    display: flex;
    min-height: 100vh;
  }

  .layout--landing {
    height: 100vh;
    overflow: hidden;
  }

  /* ── Standard content pages ── */
  .main--content {
    margin-left: var(--nav-width);
    flex: 1;
    padding: 4rem 5rem;
    min-height: 100vh;
    max-width: calc(100vw - var(--nav-width));
    overflow-x: hidden;
  }

  /* ── Landing: full height flex column, no extra padding ── */
  .main--landing {
    margin-left: var(--nav-width);
    flex: 1;
    display: flex;
    flex-direction: column;
    height: 100vh;
    max-width: calc(100vw - var(--nav-width));
    overflow: hidden;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .main--content { padding: 3rem 3.5rem; }
  }

  @media (max-width: 768px) {
    .layout { flex-direction: column; }
    .main--content,
    .main--landing {
      margin-left: 0;
      max-width: 100vw;
      height: auto;
    }
    .main--content { padding: 2rem 1.5rem; }
    .layout--landing { height: auto; overflow: visible; }
  }
</style>