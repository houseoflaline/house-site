---
import Navigation from '../components/Navigation.astro';
import '../styles/tokens.css';

interface Props {
  title: string;
  currentPath?: string;
  landing?: boolean;
}

const { title, currentPath = '/', landing = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{landing ? title : `${title} · House of Laline`}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body class={landing ? 'is-landing' : ''}>
  <div class="layout">
    <Navigation currentPath={currentPath} />
    <main class={landing ? 'main--landing' : 'main--content'}>
      <slot />
    </main>
  </div>
</body>
</html>

<style>
  html, body {
    height: 100%;
    overflow: hidden;
  }

  body.is-landing {
    overflow: hidden;
  }

  .layout {
    display: flex;
    height: 100vh;
    overflow: hidden;
  }

  /* ── Standard content pages ── */
  .main--content {
    margin-left: var(--nav-width);
    flex: 1;
    padding: 4rem 5rem;
    max-width: 860px;
    overflow-y: auto;
    height: 100vh;
  }

  /* ── Landing — full height, no scroll, no centering (index.astro handles layout) ── */
  .main--landing {
    margin-left: var(--nav-width);
    flex: 1;
    height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 1024px) {
    .main--content { padding: 3rem 3.5rem; }
  }

  @media (max-width: 768px) {
    html, body { overflow: auto; }
    .layout { flex-direction: column; height: auto; }
    .main--content,
    .main--landing {
      margin-left: 0;
      padding: 2rem 1.5rem;
      height: auto;
    }
  }
</style>