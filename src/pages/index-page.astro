---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Index" currentPath="/index-page">
  <h1>Index</h1>
  <p class="page-meta">Complete directory of all resources · February 2026</p>

  <ul class="section-list">
    <li>
      <a href="/preface">Preface</a>
      <p class="section-desc">An introduction to the house, its purpose, and its position.</p>
    </li>
    <li>
      <a href="/doctrine">Doctrine</a>
      <p class="section-desc">System principles, structural constraints, and mandatory rules.</p>
    </li>
    <li>
      <a href="/manifesto">Manifesto</a>
      <p class="section-desc">Twelve principles across Foundations, Composition, and Expression.</p>
    </li>
    <li>
      <a href="/texts">Texts</a>
      <p class="section-desc">Long-form essays on design thinking, methodology, and practice.</p>
    </li>
    <li>
      <a href="/plates">Plates</a>
      <p class="section-desc">Distilled design principles. Citable, quotable maxims.</p>
    </li>
    <li>
      <a href="/decision-framework">Frameworks</a>
      <p class="section-desc">Decision frameworks for design practice.</p>
    </li>
    <li>
      <a href="/measured-design">Measures</a>
      <p class="section-desc">Modular scale, grid anatomy, rhythm and spacing.</p>
    </li>
    <li>
      <a href="/style-ecosystem">System</a>
      <p class="section-desc">Style ecosystem, resources, and glossary.</p>
    </li>
  </ul>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 0.5rem;
  }

  .page-meta {
    font-family: var(--font-nav);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    font-style: italic;
    color: var(--color-text);
    opacity: 0.6;
    margin-bottom: 3rem;
  }

  .section-list {
    list-style: none;
    margin-top: 1rem;
  }

  .section-list li {
    margin-bottom: 1.75rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid rgba(42, 42, 37, 0.12);
  }

  .section-list li:last-child {
    border-bottom: none;
  }

  .section-list a {
    font-family: var(--font-body);
    font-size: 1.15rem;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }

  .section-list a:hover {
    border-bottom-color: var(--color-text);
    opacity: 1;
  }

  .section-desc {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-text);
    opacity: 0.65;
    margin-top: 0.4rem;
    margin-bottom: 0;
    line-height: 1.6;
  }
</style>