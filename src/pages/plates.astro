---
import BaseLayout from '../layouts/BaseLayout.astro';

const noticeUrl = import.meta.env.PUBLIC_NOTICE_URL ?? 'https://notice.laline.house';
---

<BaseLayout title="Plates" currentPath="/plates">
  <div class="breadcrumb">
    <a href="/">Entry</a> / Plates
  </div>

  <h1>Plates</h1>
  <p class="page-meta">Small distributable structures · 1 Plate · 2026</p>

  <div class="content-section">
    <p>
      Plates are small, complete structures issued for a specific use. Each one is resolved, portable and prepared to stand independently from the House site.
    </p>
  </div>

  <section class="working-proof" id="notice" aria-labelledby="notice-title">
    <div class="proof-copy">
      <p class="proof-reference">P01 · First working proof</p>
      <h2 id="notice-title">Notice</h2>
      <p class="proof-lede">A resolved announcement for one event, one image and one action.</p>
      <p class="proof-note">
        Notice puts emphasis into practice. Replace the declared content and the image; hierarchy, spacing and responsive behaviour remain decided.
      </p>
      <div class="proof-actions">
        <a href={noticeUrl}>Open Notice <span aria-hidden="true">↗</span></a>
        <span>Astro marketplace · Preparing release</span>
      </div>
    </div>
    <a class="proof-frame" href={noticeUrl} aria-label="Open the Notice working proof">
      <img src="/images/notice-everything-unsaid.jpg" alt="A dark botanical form dissolving into pale paper." width="1024" height="1536" />
      <div class="proof-title" aria-hidden="true">
        <span>Everything</span>
        <span>that remains</span>
        <em>unsaid</em>
      </div>
      <span class="proof-date">04—28.09.26</span>
    </a>
  </section>

</BaseLayout>

<style>
  .breadcrumb {
    font-size: 0.9rem;
    color: var(--color-reading-ink);
    margin-bottom: 3rem;
  }

  .breadcrumb a {
    color: var(--color-reading-ink);
    text-decoration: underline;
  }

  .breadcrumb a:hover {
    color: var(--color-ink);
  }

  .page-meta {
    font-size: 0.9rem;
    color: var(--color-reading-ink);
    margin-bottom: 3rem;
    font-style: italic;
  }

  .content-section {
    margin-bottom: 3rem;
  }

  .working-proof {
    display: grid;
    grid-template-columns: minmax(15rem, .72fr) minmax(21rem, 1.28fr);
    margin: 0 0 clamp(5rem, 10vw, 8rem);
    border-top: 1px solid var(--color-ink);
    border-bottom: 1px solid var(--color-ink);
  }

  .proof-copy {
    display: flex;
    flex-direction: column;
    padding: clamp(2rem, 5vw, 4rem) clamp(2rem, 5vw, 4rem) clamp(2rem, 5vw, 4rem) 0;
  }

  .proof-reference,
  .proof-actions a,
  .proof-actions span,
  .proof-date {
    font-family: var(--font-ui);
    font-size: var(--text-micro);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
  }

  .proof-reference { margin: 0; color: var(--color-reading-ink); }

  :global(.main--content) .proof-copy h2 {
    position: relative;
    z-index: 1;
    margin: auto 0 clamp(2rem, 3vw, 2.75rem);
    font-family: var(--font-display) !important;
    font-size: clamp(3.8rem, 8vw, 7rem) !important;
    font-weight: var(--weight-light) !important;
    letter-spacing: -.04em !important;
    line-height: .9 !important;
    text-transform: none !important;
  }

  .proof-lede {
    max-width: 26ch;
    margin: 0 0 1.5rem;
    color: var(--color-reading-ink);
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    line-height: 1.55;
  }

  .proof-note { max-width: 42ch; margin: 0 0 2.5rem; color: var(--color-secondary); font-size: .92rem; line-height: 1.65; }
  .proof-actions { display: flex; flex-wrap: wrap; gap: 1rem 2rem; }
  .proof-actions a { padding-bottom: .35rem; border-bottom: 1px solid currentColor; color: var(--color-ink); text-decoration: none; }
  .proof-actions span { color: var(--color-reading-ink); }

  .proof-frame {
    position: relative;
    min-height: clamp(35rem, 68vw, 52rem);
    border-left: 1px solid var(--color-ink);
    color: var(--color-ink);
    overflow: hidden;
  }
  .proof-frame img { display: block; width: 58%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.08); mix-blend-mode: multiply; }
  .proof-title { position: absolute; z-index: 1; top: 24%; right: 2%; width: 53%; color: var(--color-ink); font-family: var(--font-ui); font-size: clamp(1.65rem, 2.7vw, 2.8rem); letter-spacing: -.045em; line-height: .92; }
  .proof-title span, .proof-title em { display: block; font-weight: var(--weight-regular); }
  .proof-title span:nth-child(2) { padding-left: .3em; }
  .proof-title em { color: var(--color-reading-ink); font-style: italic; }
  .proof-date { position: absolute; right: 1.3rem; bottom: 1.3rem; color: var(--color-reading-ink); }

  @media (max-width: 760px) {
    .working-proof { grid-template-columns: 1fr; }
    .proof-copy { min-height: 31rem; padding-right: 0; }
    .proof-frame { min-height: 36rem; border-top: 1px solid var(--color-ink); border-left: 0; }
    .proof-frame img { width: 100%; opacity: .72; }
    .proof-title { top: auto; right: 1rem; bottom: 4.5rem; left: 1rem; width: auto; font-size: clamp(2.5rem, 12vw, 4.5rem); }
  }

</style>
