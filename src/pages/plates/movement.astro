    color: var(--color-ink);
  }

  .principle-document {
    max-width: 700px;
  }

  .principle-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .principle-meta {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--color-muted);
    text-transform: uppercase;
    flex-wrap: wrap;
  }

  .principle-meta .see-also {
    font-style: italic;
    text-transform: none;
  }

  .principle-meta .see-also a {
    color: var(--color-ink);
    text-decoration: underline;
  }

  .principle-header h1 {
    font-size: 2.25rem;
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .abstract {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--color-reading-ink);
    font-style: italic;
  }

  .principle-content h2 {
    font-size: 1.3rem;
    font-weight: 400;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .principle-content p {
    margin-bottom: 1.5rem;
    line-height: 1.8;
  }

  .citation-text {
    font-size: 0.95rem;
    color: var(--color-reading-ink);
    font-style: italic;
  }

  .citation-text strong {
    color: var(--color-ink);
    font-weight: 600;
    font-style: normal;
  }

  .citation-text a {
    color: var(--color-ink);
    text-decoration: underline;
  }
</style>
