---
import BaseLayout from '../layouts/BaseLayout.astro';

const atlasUrl = import.meta.env.PUBLIC_ATLAS_URL ?? 'http://127.0.0.1:4322';
---

<BaseLayout title="House of Laline" landing={true}>
  <header class="mobile-header">
    <a href="/" class="mobile-brand">House of Laline</a>
    <a href="/works">Works</a>
  </header>

  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-meta">
      <span>Editorial publishing house</span>
      <span>Est. 2026</span>
    </div>

    <div class="hero-centre">
      <h1 id="hero-title" class="display">House <span class="of">of</span> Laline</h1>
      <p class="hero-statement">
        Resolved digital structures built for specific purposes.
        The decisions are made. The content remains yours.
      </p>
      <p class="eyebrow hero-position">Structures, not templates</p>
    </div>

  </section>

  <section class="position" aria-labelledby="position-title">
    <p class="eyebrow">The position</p>
    <h2 id="position-title">Architecture follows intent.</h2>
    <div class="position-copy">
      <p>
        Most digital products begin with a blank canvas and an abundance of options.
        Laline begins with a question: what must this structure allow someone to do?
      </p>
      <p>
        Each Work fixes the hierarchy, pacing, navigation and typographic system around
        that answer. People replace the content and wording within declared boundaries;
        they do not have to redesign the decisions that make the structure coherent.
      </p>
    </div>
    <a href="/preface" class="text-link">Why this exists <span aria-hidden="true">→</span></a>
  </section>

  <section class="featured" id="featured-work" aria-labelledby="atlas-title">
    <div class="featured-intro">
      <p class="section-number">W01 · Atlas build 1.0</p>
      <h2 id="atlas-title">Atlas</h2>
      <p class="featured-lede">
        A photographer website system composed of three resolved architectures.
        Each volume begins with what the visitor is there to do.
      </p>
      <div class="featured-actions">
        <a href={atlasUrl} class="text-link">Enter Atlas <span aria-hidden="true">↗</span></a>
        <a href="/works" class="text-link text-link--quiet">Read the edition note <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <ol class="volumes" aria-label="Atlas volumes">
      <li>
        <span class="volume-number">I</span>
        <div>
          <h3>Still</h3>
          <p>One image at a time, for photographs that need undivided attention.</p>
        </div>
      </li>
      <li>
        <span class="volume-number">II</span>
        <div>
          <h3>Sequence</h3>
          <p>Authored pacing for bodies of work understood through order.</p>
        </div>
      </li>
      <li>
        <span class="volume-number">III</span>
        <div>
          <h3>Index</h3>
          <p>Range, relevance and contact for photographers being considered for hire.</p>
        </div>
      </li>
    </ol>
  </section>

  <section class="house-index" aria-labelledby="house-title">
    <div class="index-intro">
      <p class="section-number">Directory · Ref. 01—04</p>
      <h2 id="house-title">House</h2>
      <p class="featured-lede">
        A publishing system organised to grow without losing its shape.
        Its works, texts and principles remain distinct while reading as parts of one house.
      </p>
      <p class="index-reference">Four points of entry · One governing structure</p>
    </div>

    <nav class="index-links" aria-label="House sections">
      <a href="/works">
        <span>Works</span>
        <small>Resolved structures and their editions</small>
        <span aria-hidden="true">01</span>
      </a>
      <a href="/texts">
        <span>Texts</span>
        <small>Arguments, observations and reading material</small>
        <span aria-hidden="true">02</span>
      </a>
      <a href="/doctrine">
        <span>Doctrine</span>
        <small>Principles and structural constraints</small>
        <span aria-hidden="true">03</span>
      </a>
      <a href="/manifesto">
        <span>Manifesto</span>
        <small>Foundations, composition and expression</small>
        <span aria-hidden="true">04</span>
      </a>
    </nav>
  </section>

  <footer class="site-footer">
    <div class="footer-note">
      <span>Built slowly</span>
      <span>Issued when ready</span>
      <span>Est. 2026</span>
    </div>
  </footer>
</BaseLayout>

<style>
  :global(html) { scroll-behavior: smooth; }

  .mobile-header { display: none; }

  .featured-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }

  .text-link--quiet { color: var(--color-secondary); }

  .hero,
  .featured,
  .position,
  .house-index,
  .site-footer {
    padding-left: clamp(1.5rem, 5vw, 4.5rem);
    padding-right: clamp(1.5rem, 5vw, 4.5rem);
  }

  .hero {
    min-height: 92svh;
    display: grid;
    grid-template-rows: auto 1fr;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-meta,
  .hero-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 3.5rem;
    padding-bottom: 1.5rem;
    font-family: var(--font-ui);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .hero-meta { border-bottom: 1px solid var(--color-border); }
  .hero-footer { padding-top: 1.5rem; padding-bottom: 3rem; }

  .hero-centre {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    max-width: 880px;
    padding: 12vh 0;
  }

  .eyebrow {
    font-family: var(--font-ui);
    font-size: var(--text-micro);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-ink);
    margin-bottom: 1.5rem;
  }

  h1.display {
    font-size: clamp(4rem, 9vw, 8.5rem);
    line-height: 0.9;
    margin: 0 0 3rem;
  }

  .hero-statement {
    font-family: var(--font-ui);
    font-size: clamp(0.8rem, 1.1vw, 0.95rem);
    font-weight: var(--weight-regular);
    line-height: 1.8;
    letter-spacing: 0.01em;
    max-width: 680px;
    color: var(--color-ink);
    margin: 0;
  }

  .hero-position {
    margin-top: 3rem;
    margin-bottom: 0;
    color: var(--color-reading-ink);
  }

  .enter,
  .text-link {
    font-family: var(--font-ui);
    font-size: var(--text-nav);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .featured,
  .house-index {
    display: grid;
    grid-template-columns: minmax(280px, 0.9fr) minmax(380px, 1.1fr);
    gap: 0;
    padding-top: clamp(6rem, 12vh, 9rem);
    padding-bottom: clamp(6rem, 12vh, 9rem);
    border-bottom: 1px solid var(--color-border);
  }

  .featured-intro,
  .index-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: 1.4rem;
    padding-right: clamp(3rem, 7vw, 7rem);
    border-top: 1px solid var(--color-ink);
  }

  .section-number {
    font-family: var(--font-ui);
    font-size: var(--text-nav);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    margin: 0 0 clamp(2.75rem, 6vh, 4.5rem);
  }

  .featured h2,
  .position h2,
  .house-index h2 {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 5vw, 5rem);
    font-weight: var(--weight-light);
    letter-spacing: 0;
    line-height: 1;
    text-transform: none;
    color: var(--color-ink);
    margin: 0 0 2rem;
  }

  .featured-lede {
    font-size: 1.08rem;
    line-height: 1.8;
    color: var(--color-secondary);
    margin-bottom: 2rem;
  }

  .volumes {
    list-style: none;
    margin-top: 0;
    padding-top: clamp(3.7rem, 7vh, 5rem);
    padding-left: clamp(3rem, 6vw, 6rem);
    border-left: 1px solid var(--color-border);
    border-top: 1px solid var(--color-ink);
  }
  .volumes li {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 1rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .volume-number {
    font-family: var(--font-ui);
    font-size: var(--text-nav);
    color: var(--color-secondary);
  }
  .volumes h3 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: var(--weight-regular);
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-ink);
    margin: 0 0 0.45rem;
  }
  .volumes p { color: var(--color-secondary); margin: 0; font-size: 0.9rem; line-height: 1.6; }

  .position {
    padding-top: clamp(7rem, 15vh, 11rem);
    padding-bottom: clamp(7rem, 15vh, 11rem);
    border-bottom: 1px solid var(--color-border);
  }
  .position h2 { max-width: 800px; }
  .position-copy {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 6vw, 7rem);
    max-width: 960px;
    margin: 3rem 0 2rem;
  }
  .position-copy p { font-size: 1.05rem; line-height: 1.85; margin: 0; }

  .index-reference {
    margin: 0;
    padding-top: 0;
    font-family: var(--font-ui);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-secondary);
  }
  .index-links {
    padding-left: clamp(3rem, 6vw, 6rem);
    padding-top: clamp(3.7rem, 7vh, 5rem);
    border-left: 1px solid var(--color-border);
    border-top: 1px solid var(--color-ink);
  }
  .index-links a {
    display: grid;
    grid-template-columns: 100px 1fr 24px;
    gap: 1rem;
    align-items: baseline;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-display);
    font-size: 1.25rem;
  }
  .index-links small,
  .index-links a > span:last-child {
    font-family: var(--font-ui);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    color: var(--color-secondary);
  }

  .site-footer {
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    gap: 0;
    padding-top: 3rem;
    padding-bottom: 3rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-ink);
  }
  .site-footer p,
  .site-footer a,
  .site-footer span {
    color: inherit;
    font-family: var(--font-ui);
    font-size: 0.5rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    margin: 0;
  }
  .footer-note {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    padding-left: 0;
  }
  .footer-note span { white-space: nowrap; }

  @media (max-width: 1050px) {
    .featured,
    .house-index { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); }
    .index-intro { padding-right: clamp(2rem, 5vw, 4rem); }
    .index-links { padding-left: clamp(2rem, 5vw, 4rem); }
  }

  @media (max-width: 900px) {
    .featured,
    .house-index { display: block; }
    .featured-intro,
    .index-intro { padding-right: 0; }
    .volumes {
      margin-top: 4rem;
      padding-top: 0;
      padding-left: 0;
      border-left: 0;
    }
    .index-links {
      margin-top: 4rem;
      padding-top: 0;
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 768px) {
    .mobile-header {
      display: flex;
      justify-content: space-between;
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid var(--color-border);
      font-family: var(--font-ui);
      font-size: var(--text-nav);
      letter-spacing: var(--tracking-widest);
      text-transform: uppercase;
    }
    .mobile-brand { font-weight: var(--weight-bold); }
    .hero { min-height: calc(92svh - 58px); }
    .hero-meta { padding-top: 1.5rem; }
    .hero-centre { padding: 10vh 0; }
    h1.display { font-size: clamp(3.6rem, 19vw, 6rem); margin-bottom: 2rem; }
    .hero-statement { font-size: 0.8rem; }
    .hero-position { margin-top: 2.5rem; }
    .section-number { margin-bottom: 4rem; }
    .position-copy { grid-template-columns: 1fr; gap: 1rem; }
    .index-links a { grid-template-columns: 90px 1fr 24px; }
    .index-meta { margin-bottom: 4rem; }
    .index-reference { padding-top: 0; }
    .footer-note { align-items: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
  }
</style>
