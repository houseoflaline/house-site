---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
---

<BaseLayout title="House of Laline">
  <Navigation currentPath="/" />

  <main class="landing">

    <div class="top-bar">
      <span class="top-left">Editorial publishing house</span>
      <span class="top-right">V1.0 · Est. 2026</span>
    </div>

    <div class="title-block">
      <h1 class="display">House <span class="of">of</span> Laline</h1>
    </div>

    <div class="bottom-bar">
      <div class="tagline-block">
        <p class="tagline">Architecture for the digital world.</p>
        <a href="/index-page" class="enter">Enter the system →</a>
      </div>
      <div class="meta-stack">
        <span>London</span>
        <span>Est. 2026</span>
      </div>
    </div>

  </main>
</BaseLayout>

<style>
  /* ── Landing layout ── */
  main.landing {
    margin-left: var(--nav-width);
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 3.5rem 4rem 4.5rem 4.5rem;
    background: var(--color-bg);
  }

  /* ── Top bar ── */
  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .top-left {
    font-family: var(--font-ui);
    font-size: var(--text-nav);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-secondary);
  }

  .top-right {
    font-family: var(--font-ui);
    font-size: var(--text-nav);
    letter-spacing: var(--tracking-widest);
    color: var(--color-secondary);
    opacity: 0.6;
  }

  /* ── Display title ── */
  .title-block {
    flex: 1;
    display: flex;
    align-items: flex-end;
  }

  h1.display {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(2.5rem, 4.5vw, 5.5rem);
    font-weight: var(--weight-regular);
    letter-spacing: 0.02em;
    line-height: var(--leading-tight);
    color: var(--color-ink);
    margin-bottom: 3rem;
    white-space: nowrap;
  }

  h1.display .of {
    font-size: 0.45em;
    opacity: 0.85;
    letter-spacing: 0.06em;
    margin: 0 0.05em;
    vertical-align: middle;
  }

  /* ── Bottom bar ── */
  .bottom-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
    margin-top: -2.5rem;
  }

  .tagline-block {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .tagline {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: var(--weight-light);
    font-style: italic;
    color: var(--color-ink);
    line-height: 1.85;
    max-width: none;
    margin-bottom: 0;
  }

  .enter {
    font-family: var(--font-ui);
    font-size: var(--text-nav);
    font-weight: var(--weight-regular);
    letter-spacing: 0.04em;
    color: var(--color-secondary);
    text-decoration: none;
    transition: opacity var(--primitive-motion-base);
  }
  .enter:hover { opacity: 0.5; }

  .meta-stack {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-family: var(--font-ui);
    font-size: 0.46rem;
    letter-spacing: var(--tracking-wider);
    color: var(--color-secondary);
    opacity: 0.85;
    line-height: 1.8;
  }
</style>