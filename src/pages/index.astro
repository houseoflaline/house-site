---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="House of Laline" landing={true}>

  <div class="top-bar">
    <span class="top-left">Editorial publishing house</span>
    <span class="top-right">V1.0 · Est. 2026</span>
  </div>

  <h1 class="display">House <span class="of">of</span> Laline</h1>

  <div class="bottom-bar">
    <div class="tagline-block">
      <p class="tagline">Architecture for the digital world.</p>
      <a href="/index-page" class="enter">Enter the system →</a>
    </div>
    <div class="meta-stack">
      <span>London</span>
      <span>Est. 2026</span>
    </div>
  </div>

</BaseLayout>

<style>
  /* ── Top bar ── */
  .top-bar {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 3.5rem 4rem 1.75rem 4.5rem;
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .top-left {
    font-family: var(--font-ui);
    font-size: var(--text-nav);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-secondary);
  }

  .top-right {
    font-family: var(--font-ui);
    font-size: var(--text-nav);
    letter-spacing: var(--tracking-widest);
    color: var(--color-secondary);
    opacity: 0.6;
  }

  /* ── Display title — pushed to lower third ── */
  h1.display {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(2.5rem, 4.5vw, 5.5rem);
    font-weight: var(--weight-regular);
    letter-spacing: 0.02em;
    line-height: 0.92;
    color: var(--color-ink);
    white-space: nowrap;
    margin-top: auto;
    margin-bottom: 0;
    padding: 0 4rem 0 4.5rem;
    flex-shrink: 0;
  }

  h1.display .of {
    font-size: 0.45em;
    opacity: 0.85;
    letter-spacing: 0.06em;
    margin: 0 0.05em;
    vertical-align: middle;
  }

  /* ── Bottom bar ── */
  .bottom-bar {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-top: 1px solid var(--color-border);
    padding: 1.25rem 4rem 4.5rem 4.5rem;
    margin-top: 1.5rem;
    flex-shrink: 0;
  }

  .tagline-block {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .tagline {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: var(--weight-light);
    font-style: italic;
    color: var(--color-ink);
    line-height: 1.85;
    max-width: none;
    margin-bottom: 0;
  }

  .enter {
    font-family: var(--font-ui);
    font-size: var(--text-nav);
    font-weight: var(--weight-regular);
    letter-spacing: 0.04em;
    color: var(--color-secondary);
    text-decoration: none;
    transition: opacity var(--primitive-motion-base);
  }
  .enter:hover { opacity: 0.5; }

  .meta-stack {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-family: var(--font-ui);
    font-size: 0.46rem;
    letter-spacing: var(--tracking-wider);
    color: var(--color-secondary);
    opacity: 0.85;
    line-height: 1.8;
  }
</style>