---
import BaseLayout from '../layouts/BaseLayout.astro';

const atlasUrl = import.meta.env.PUBLIC_ATLAS_URL ?? 'https://atlas.laline.house';
const aureleUrl = import.meta.env.PUBLIC_AURELE_URL ?? 'https://aurele.laline.house';
const allureUrl = import.meta.env.PUBLIC_ALLURE_URL ?? 'https://allure.laline.house';
const atlasReadingUrl = `${atlasUrl.replace(/\/$/, '')}/#reading`;
const aureleReadingUrl = `${aureleUrl.replace(/\/$/, '')}/#reading`;
---

<BaseLayout title="House of Laline" landing={true}>
  <header class="mobile-header">
    <a href="/" class="mobile-brand">House of Laline</a>
    <a href="/works">Works</a>
  </header>

  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-meta">
      <span>Independent design house</span>
      <span>Est. 2025</span>
    </div>

    <div class="hero-centre">
      <h1 id="hero-title" class="display">House <span class="of">of</span> Laline</h1>
      <p class="hero-statement">
        <span>Digital structures shaped around what the work needs to do.</span>
        <span>Hierarchy, pacing and behaviour are resolved.</span>
        <span>The content remains yours.</span>
      </p>
    </div>

  </section>

  <section class="position" aria-labelledby="position-title">
    <p class="eyebrow">The position</p>
    <h2 id="position-title">Architecture follows intent.</h2>
    <div class="position-copy">
      <div class="position-copy-column">
        <p>
          Most digital products begin with a blank canvas and an abundance of options.
          Laline begins with a question: what must this structure allow someone to do?
        </p>
        <a href="/preface" class="text-link">Why this exists <span aria-hidden="true">→</span></a>
      </div>
      <p>
        Each Work fixes the hierarchy, pacing, navigation and typographic system around
        that answer. People replace the content and wording within declared boundaries;
        they do not have to redesign the decisions that make the structure coherent.
      </p>
    </div>
  </section>

  <section class="featured" id="featured-work" aria-labelledby="atlas-title">
    <p class="section-number section-reference">W01 · Atlas version 1.0</p>
    <h2 id="atlas-title" class="section-title section-heading">Atlas</h2>
    <div class="featured-intro">
      <p class="featured-lede">
        A photographer website system composed of three resolved architectures.
        Each volume begins with what the visitor is there to do.
      </p>
      <div class="featured-actions">
        <a href={atlasUrl} class="text-link">Enter Atlas <span aria-hidden="true">↗</span></a>
        <a href={atlasReadingUrl} class="text-link text-link--quiet">Read within Atlas <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <ol class="volumes" aria-label="Atlas volumes">
      <li>
        <span class="volume-number">I</span>
        <div>
          <h3>Still</h3>
          <p>One image at a time, for photographs that need undivided attention.</p>
        </div>
      </li>
      <li>
        <span class="volume-number">II</span>
        <div>
          <h3>Sequence</h3>
          <p>Authored pacing for bodies of work understood through order.</p>
        </div>
      </li>
      <li>
        <span class="volume-number">III</span>
        <div>
          <h3>Index</h3>
          <p>Range, relevance and contact for photographers being considered for hire.</p>
        </div>
      </li>
    </ol>
  </section>

  <section class="featured" id="aurele" aria-labelledby="aurele-title">
    <p class="section-number section-reference">W02 · Aurèle version 1.0</p>
    <h2 id="aurele-title" class="section-title section-heading">Aurèle</h2>
    <div class="featured-intro">
      <p class="featured-lede">
        An editorial publishing structure for a public record.
        One identity changes pace across immediate report, accumulated history and considered argument.
      </p>
      <div class="featured-actions">
        <a href={aureleUrl} class="text-link">Enter Aurèle <span aria-hidden="true">↗</span></a>
        <a href={aureleReadingUrl} class="text-link text-link--quiet">Read within Aurèle <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <ol class="volumes" aria-label="Aurèle structures">
      <li>
        <span class="volume-number">I</span>
        <div><h3>Dispatch</h3><p>Mona leaves-a! The smile that slipped away.</p></div>
      </li>
      <li>
        <span class="volume-number">II</span>
        <div><h3>Chronicle</h3><p>1911—1913. The image circulates; the object does not. The accumulating record keeps the interval visible.</p></div>
      </li>
      <li>
        <span class="volume-number">III</span>
        <div><h3>Review</h3><p>Absence did not erase the image. It multiplied it.</p></div>
      </li>
    </ol>
  </section>

  <section class="featured" id="allure" aria-labelledby="allure-title">
    <p class="section-number section-reference">W03 · Allure working edition</p>
    <h2 id="allure-title" class="section-title section-heading">Allure</h2>
    <div class="featured-intro">
      <p class="featured-lede">
        A portfolio structure that presents one professional record through three resolved hierarchies.
        The facts remain constant; their emphasis, pace and mode of reading change.
      </p>
      <div class="featured-actions">
        <a href={allureUrl} class="text-link">Enter Allure <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <ol class="volumes" aria-label="Allure structures">
      <li>
        <span class="volume-number">I</span>
        <div><h3>Retenue</h3><p>Work organised by fact and proof.</p></div>
      </li>
      <li>
        <span class="volume-number">II</span>
        <div><h3>Éclat</h3><p>Work organised by capability and connection.</p></div>
      </li>
      <li>
        <span class="volume-number">III</span>
        <div><h3>Poise</h3><p>Work organised by time and consequence.</p></div>
      </li>
    </ol>
  </section>

  <section class="house-index" aria-labelledby="house-title">
    <p class="section-number section-reference">Directory · Ref. 01—04</p>
    <h2 id="house-title" class="section-title section-heading">House</h2>
    <div class="index-intro">
      <p class="featured-lede">
        A publishing system organised to grow without losing its shape.
        Its works, texts and principles remain distinct while reading as parts of one house.
      </p>
      <p class="index-reference">Four points of entry · One governing structure</p>
    </div>

    <nav class="index-links" aria-label="House sections">
      <a href="/manifesto">
        <span class="index-number" aria-hidden="true">01</span>
        <span>Manifesto</span>
        <small>Foundations, composition and expression</small>
      </a>
      <a href="/texts">
        <span class="index-number" aria-hidden="true">02</span>
        <span>Texts</span>
        <small>Arguments, observations and reading material</small>
      </a>
      <a href="/plates">
        <span class="index-number" aria-hidden="true">03</span>
        <span>Plates</span>
        <small>Design principles made visible</small>
      </a>
      <a href="/works">
        <span class="index-number" aria-hidden="true">04</span>
        <span>Works</span>
        <small>Resolved structures and their editions</small>
      </a>
    </nav>
  </section>

  <footer class="site-footer">
    <span>Est. 2025</span>
  </footer>
</BaseLayout>

<style>
  :global(html) { scroll-behavior: smooth; }

  .mobile-header { display: none; }

  .featured-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }

  .text-link--quiet { color: var(--color-secondary); }

  .hero,
  .featured,
  .position,
  .house-index,
  .site-footer {
    padding-left: clamp(1.5rem, 5vw, 4.5rem);
    padding-right: clamp(1.5rem, 5vw, 4.5rem);
  }

  .hero {
    min-height: 92svh;
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .hero-meta,
  .hero-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 3.5rem;
    padding-bottom: 1.5rem;
    font-family: var(--font-ui);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .hero-meta { border-bottom: 1px solid var(--color-border); }
  .hero-footer { padding-top: 1.5rem; padding-bottom: 3rem; }

  .hero-centre {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    max-width: 880px;
    padding: 12vh 0;
  }

  .eyebrow {
    font-family: var(--font-ui);
    font-size: var(--text-micro);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-ink);
    margin-bottom: 1.5rem;
  }

  h1.display {
    font-size: clamp(4rem, 9vw, 8.5rem);
    line-height: 0.9;
    margin: 0 0 3rem;
  }

  .hero-statement {
    font-family: var(--font-ui);
    font-size: clamp(0.8rem, 1.1vw, 0.95rem);
    font-weight: var(--weight-regular);
    line-height: 1.8;
    letter-spacing: 0.01em;
    max-width: 680px;
    color: var(--color-ink);
    margin: 0;
  }

  .hero-statement span {
    display: block;
  }

  .enter,
  .text-link {
    font-family: var(--font-ui);
    font-size: var(--text-nav);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .featured,
  .house-index {
    display: grid;
    grid-template-columns: minmax(280px, 0.9fr) minmax(380px, 1.1fr);
    gap: 0;
    padding-top: clamp(6rem, 12vh, 9rem);
    padding-bottom: clamp(6rem, 12vh, 9rem);
  }

  .featured-intro,
  .index-intro {
    grid-column: 1;
    grid-row: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: 0;
    padding-right: clamp(3rem, 7vw, 7rem);
  }

  .section-number {
    font-family: var(--font-ui);
    font-size: var(--text-nav);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    margin: 0;
  }

  .section-reference {
    grid-column: 1 / -1;
    grid-row: 1;
    width: 100%;
    max-width: none;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-ink);
  }

  .section-heading {
    grid-column: 1 / -1;
    grid-row: 2;
    padding-top: clamp(2.75rem, 6vh, 4.5rem);
  }

  .section-title,
  .position h2,
  .featured h2,
  .house-index h2 {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 5vw, 5rem);
    font-weight: var(--weight-light);
    letter-spacing: 0;
    line-height: 1;
    text-transform: none;
    color: var(--color-ink);
    margin: 0 0 2.25rem;
  }

  .featured-lede {
    font-size: 1.08rem;
    line-height: 1.8;
    color: var(--color-secondary);
    margin: 0 0 1.5rem;
  }

  .volumes {
    grid-column: 2;
    grid-row: 3;
    list-style: none;
    margin-top: 0;
    padding-top: 0;
    padding-left: clamp(3rem, 6vw, 6rem);
  }
  .volumes li {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .volumes li:first-child { padding-top: 0; }
  .volumes li:last-child { border-bottom: 0; }
  .volume-number {
    font-family: var(--font-ui);
    font-size: var(--text-nav);
    color: var(--color-secondary);
  }
  .volumes h3 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: var(--weight-regular);
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-ink);
    margin: 0 0 0.45rem;
  }
  .volumes p { color: var(--color-secondary); margin: 0; font-size: 0.9rem; line-height: 1.6; }

  .position {
    padding-top: clamp(7rem, 15vh, 11rem);
    padding-bottom: clamp(7rem, 15vh, 11rem);
  }
  .position h2 { max-width: 800px; }
  .position-copy {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 6vw, 7rem);
    max-width: 960px;
    margin: 3rem 0 2rem;
  }
  .position-copy p { font-size: 1.05rem; line-height: 1.85; margin: 0; }
  .position-copy-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.75rem;
  }

  .index-reference {
    margin: 0;
    padding-top: 0;
    font-family: var(--font-ui);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-secondary);
  }
  .index-links {
    grid-column: 2;
    grid-row: 3;
    padding-left: clamp(3rem, 6vw, 6rem);
    padding-top: 0;
  }
  .index-links a {
    display: grid;
    grid-template-columns: 36px 1fr;
    column-gap: 1rem;
    row-gap: 0.35rem;
    align-items: start;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-display);
    font-size: 1.25rem;
  }
  .index-links a:first-child { padding-top: 0; }
  .index-links a:last-child { border-bottom: 0; }
  .index-number {
    font-family: var(--font-ui);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    color: var(--color-secondary);
  }
  .index-number { grid-row: 1 / span 2; padding-top: 0.25rem; }
  .index-links small {
    grid-column: 2;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: var(--weight-light);
    line-height: 1.6;
    letter-spacing: 0;
    color: var(--color-secondary);
  }

  .site-footer {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0;
    padding-top: 3rem;
    padding-bottom: 3rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-ink);
  }
  .site-footer p,
  .site-footer a,
  .site-footer span {
    color: inherit;
    font-family: var(--font-ui);
    font-size: 0.5rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    margin: 0;
  }
  .site-footer span { white-space: nowrap; }

  @media (max-width: 1050px) {
    .featured,
    .house-index { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); }
    .index-intro { padding-right: clamp(2rem, 5vw, 4rem); }
    .index-links { padding-left: clamp(2rem, 5vw, 4rem); }
  }

  @media (max-width: 900px) {
    .featured,
    .house-index { display: block; }
    .featured-intro,
    .index-intro { padding-right: 0; }
    .volumes {
      margin-top: 2.5rem;
      padding-top: 0;
      padding-left: 0;
    }
    .index-links {
      margin-top: 2.5rem;
      padding-top: 0;
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 768px) {
    .mobile-header {
      display: flex;
      justify-content: space-between;
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid var(--color-border);
      font-family: var(--font-ui);
      font-size: var(--text-nav);
      letter-spacing: var(--tracking-widest);
      text-transform: uppercase;
    }
    .mobile-brand { font-weight: var(--weight-bold); }
    .hero { min-height: calc(92svh - 58px); }
    .hero-meta { padding-top: 1.5rem; }
    .hero-centre { padding: 10vh 0; }
    h1.display { font-size: clamp(3.6rem, 19vw, 6rem); margin-bottom: 2rem; }
    .hero-statement { font-size: 0.8rem; }
    .section-number { margin-bottom: 4rem; }
    .section-reference { margin-bottom: 0; }
    .position-copy { grid-template-columns: 1fr; gap: 1rem; }
    .index-links a { grid-template-columns: 28px 1fr; }
    .index-meta { margin-bottom: 4rem; }
    .index-reference { padding-top: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
  }
</style>
