---
import BaseLayout from '../layouts/BaseLayout.astro';

const texts = [
  {
    number: 'T01',
    title: 'Attention',
    href: '/texts/attention',
    abstract: 'How the eye selects what the mind processes before working memory sees it.',
    published: '2026-01',
    readTime: '10 min'
  },
  {
    number: 'T02',
    title: 'Cognitive Load',
    href: '/texts/cognitive',
    abstract: 'Understanding cognitive load and its implications for interface design.',
    published: '2026-01',
    readTime: '10 min'
  },
  {
    number: 'T03',
    title: 'Contrast',
    href: '/texts/contrast',
    abstract: 'The role of contrast in establishing hierarchy and guiding attention.',
    published: '2026-01',
    readTime: '7 min'
  },
  {
    number: 'T04',
    title: 'Gestalt Perception',
    href: '/texts/gestalt',
    abstract: 'How the mind organizes visual information into coherent wholes.',
    published: '2026-01',
    readTime: '11 min'
  },
  {
    number: 'T05',
    title: 'Human Patterns',
    href: '/texts/human-patterns',
    abstract: 'Exploring the golden ratio and mathematical beauty in design through visual demonstration.',
    published: '2026-01',
    readTime: '10 min'
  },
  {
    number: 'T06',
    title: 'Sequence',
    href: '/texts/sequence',
    abstract: 'The structural role of order in how information is encountered and understood.',
    published: '2026-01',
    readTime: '10 min'
  },
  {
    number: 'T07',
    title: 'The Silence',
    href: '/texts/the-silence',
    abstract: 'What is communicated through deliberate absence and refusal.',
    published: '2026-01',
    readTime: '13 min'
  },
];
---

<BaseLayout title="Texts" currentPath="/texts">
  <div class="breadcrumb">
    <a href="/">Entry</a> / Texts
  </div>

  <h1>Texts</h1>
  <p class="page-meta">Long-form essays on design thinking · Updated February 2026</p>

  <div class="content-section">
    <p>
      Texts are extended examinations of design principles, cognitive patterns, and methodological frameworks. Each explores a single concept in depth, providing context and application guidance beyond what plates can contain.
    </p>
  </div>

  <ul class="text-list">
    {texts.map(text => (
      <li class="text-item">
        <div class="text-number">{text.number}</div>
        <div class="text-content">
          <h3><a href={text.href}>{text.title}</a></h3>
          <p class="text-abstract">{text.abstract}</p>
          <div class="text-meta">
            Published {text.published} · {text.readTime} read
          </div>
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .breadcrumb {
    font-size: 0.9rem;
    color: var(--color-reading-ink);
    margin-bottom: 3rem;
  }

  .breadcrumb a {
    color: var(--color-reading-ink);
    text-decoration: underline;
  }

  .breadcrumb a:hover {
    color: var(--color-ink);
  }

  .page-meta {
    font-size: 0.9rem;
    color: var(--color-reading-ink);
    margin-bottom: 3rem;
    font-style: italic;
  }

  .content-section {
    margin-bottom: 3rem;
  }

  .text-list {
    list-style: none;
    margin-top: 2rem;
  }

  .text-item {
    border-top: 1px solid var(--color-border);
    padding: 2rem 0;
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }

  .text-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .text-number {
    font-family: var(--font-ui);
    font-size: 0.875rem;
    color: var(--color-muted);
    min-width: 2.5rem;
    font-variant-numeric: tabular-nums;
  }

  .text-content {
    flex: 1;
  }

  .text-item h3 {
    font-size: 1.2rem;
    font-weight: 400;
    margin-bottom: 0.75rem;
  }

  .text-item h3 a {
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }

  .text-item h3 a:hover {
    border-bottom-color: var(--color-ink);
  }

  .text-abstract {
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 0.75rem;
    color: var(--color-ink);
  }

  .text-meta {
    font-size: 0.85rem;
    color: var(--color-reading-ink);
  }

  @media (max-width: 768px) {
    .text-item {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>
