---
import BaseLayout from '../../layouts/BaseLayout.astro';

const principles = [
  {
    number: 'I.1',
    plateId: 'E01-P03',
    title: 'Restraint protects meaning',
    href: '/manifesto/foundations/restraint',
    abstract: 'Meaning collapses when too many signals compete. Restraint preserves hierarchy.',
  },
  {
    number: 'I.2',
    plateId: 'E01-P02',
    title: 'Authority is recognised',
    href: '/manifesto/foundations/authority',
    abstract: 'Authority emerges through coherence held over time, not assertion or display.',
  },
  {
    number: 'I.3',
    plateId: 'E01-P04',
    title: 'Pacing is a decision about time',
    href: '/manifesto/foundations/pacing',
    abstract: 'Pacing determines how understanding forms by controlling when information is revealed.',
  },
  {
    number: 'I.4',
    plateId: 'E01-P05',
    title: 'Silence is refusal made visible',
    href: '/manifesto/foundations/silence',
    abstract: 'Silence reveals what a system has chosen not to include, without explanation.',
  },
];
---

<BaseLayout title="Foundations" currentPath="/manifesto/foundations">
  <div class="breadcrumb">
    <a href="/">Entry</a> / <a href="/manifesto">Manifesto</a> / Foundations
  </div>

  <h1>Part I: Foundations</h1>
  <p class="page-meta">Invisible structural principles · 4 principles · Updated January 2026</p>

  <div class="content-section">
    <p>
      Foundations are the invisible structural principles that must exist before design begins. These are non-negotiable constraints—refusals that create the architecture for everything else.
    </p>
    <p>
      They operate beneath the surface. You cannot see restraint, but you can see its effects. Authority is not displayed; it emerges over time. Pacing is felt, not shown. Silence communicates through absence.
    </p>
  </div>

  <ul class="principles-list">
    {principles.map(principle => (
      <li class="principle-item">
        <div class="principle-number">{principle.number}</div>
        <div class="principle-content">
          <div class="principle-header">
            <h3><a href={principle.href}>{principle.title}</a></h3>
            <span class="plate-reference">{principle.plateId}</span>
          </div>
          <p class="principle-abstract">{principle.abstract}</p>
        </div>
      </li>
    ))}
  </ul>

  <div class="foundations-note">
    <p>
      These principles form the bedrock of the LALINE system. All subsequent work—application, expression, instrumentation—depends on their consistent presence.
    </p>
  </div>
</BaseLayout>

<style>
  .breadcrumb {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 3rem;
  }

  .breadcrumb a {
    color: var(--text-secondary);
    text-decoration: underline;
  }

  .breadcrumb a:hover {
    color: var(--text);
  }

  .page-meta {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 3rem;
    font-style: italic;
  }

  .content-section {
    margin-bottom: 3rem;
    max-width: 700px;
  }

  .content-section p {
    margin-bottom: 1.5rem;
  }

  .principles-list {
    list-style: none;
    margin-top: 2rem;
    margin-bottom: 3rem;
  }

  .principle-item {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }

  .principle-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .principle-number {
    font-family: 'Courier New', monospace;
    font-size: 0.875rem;
    color: var(--text-tertiary);
    min-width: 2.5rem;
    font-variant-numeric: tabular-nums;
  }

  .principle-content {
    flex: 1;
  }

  .principle-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .principle-item h3 {
    font-size: 1.2rem;
    font-weight: 400;
    margin: 0;
  }

  .principle-item h3 a {
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }

  .principle-item h3 a:hover {
    border-bottom-color: var(--text);
  }

  .plate-reference {
    font-family: 'Courier New', monospace;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
  }

  .principle-abstract {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text);
  }

  .foundations-note {
    border-top: 1px solid var(--border);
    padding-top: 2rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
    max-width: 700px;
  }

  @media (max-width: 768px) {
    .principle-item {
      flex-direction: column;
      gap: 0.75rem;
    }

    .principle-header {
      flex-direction: column;
      gap: 0.5rem;
      align-items: flex-start;
    }
  }
</style>
