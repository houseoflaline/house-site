    gap: 1.5rem;
    margin-bottom: 1.5rem;
    font-family: 'Courier New', monospace;
    font-size: 0.8rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
  }

  .principle-header h1 {
    font-size: 2.25rem;
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .abstract {
