---
import BaseLayout from '../layouts/BaseLayout.astro';

const collections = [
  {
    number: '2.1',
    title: 'Design Principles',
    href: '/collections/design',
    meta: '47 entries · 2020–2026 · Last updated Jan 2026'
  },
  {
    number: '2.2',
    title: 'Research Archive',
    href: '/collections/research',
    meta: '128 entries · 2018–2026 · Last updated Feb 2026'
  },
  {
    number: '2.3',
    title: 'Reference Materials',
    href: '/collections/reference',
    meta: '89 entries · 2019–2026 · Last updated Dec 2025'
  },
  {
    number: '2.4',
    title: 'Methodology Documentation',
    href: '/collections/methodology',
    meta: '34 entries · 2021–2026 · Last updated Jan 2026'
  },
  {
    number: '2.5',
    title: 'System Templates',
    href: '/collections/templates',
    meta: '22 entries · 2020–2026 · Last updated Nov 2025'
  },
];
---

<BaseLayout title="Collections" currentPath="/collections">
  <div class="breadcrumb">
    <a href="/">Home</a> / Collections
  </div>

  <h1>Collections</h1>
  <p class="page-meta">Complete inventories within defined boundaries · Updated February 2026</p>

  <div class="content-section">
    <p>
      Collections represent complete, bounded sets of related material. Each collection maintains explicit scope statements, chronological organization, and standardized metadata. Content is presented in full—no summarization, no curation by relevance.
    </p>
  </div>

  <ul class="collection-list">
    {collections.map(collection => (
      <li class="collection-item">
        <div class="collection-number">{collection.number}</div>
        <div class="collection-content">
          <h3><a href={collection.href}>{collection.title}</a></h3>
          <div class="collection-meta">{collection.meta}</div>
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .breadcrumb {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 3rem;
  }

  .breadcrumb a {
    color: var(--text-secondary);
    text-decoration: underline;
  }

  .breadcrumb a:hover {
    color: var(--text);
  }

  .page-meta {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 3rem;
    font-style: italic;
  }

  .content-section {
    margin-bottom: 3rem;
  }

  .collection-list {
    list-style: none;
    margin-top: 2rem;
  }

  .collection-item {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
    display: flex;
    gap: 2rem;
    align-items: baseline;
  }

  .collection-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .collection-number {
    font-family: 'Courier New', monospace;
    font-size: 0.875rem;
    color: var(--text-tertiary);
    min-width: 2rem;
  }

  .collection-content {
    flex: 1;
  }

  .collection-item h3 {
    font-size: 1.2rem;
    font-weight: 400;
    margin-bottom: 0.5rem;
  }

  .collection-item h3 a {
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }

  .collection-item h3 a:hover {
    border-bottom-color: var(--text);
  }

  .collection-meta {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .collection-item {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
